# Postgres (Neon or similar) — pooled connection string for the app,
# direct (non-pooled) connection string for Prisma migrations.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js
AUTH_SECRET="generate-with-npx-auth-secret"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Encrypts each user's saved Gemini API key at rest (lib/crypto.ts). Any
# string works as the secret; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# Gemini - each user supplies their own key from the app's /account page
# (no server-wide fallback key). Nothing to set here.

# Anthropic (unused while the Gemini swap is active; kept for an easy revert)
ANTHROPIC_API_KEY=""
